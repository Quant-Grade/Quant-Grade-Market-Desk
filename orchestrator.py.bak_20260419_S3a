# --- Retrieval degradation counters (in-memory; shutdown print only) ---
# Named-reason observability for fragility #4 (silent retrieval degradation).
# No persisted schema change. Counters reset per process; never written to disk.
_RAG_COUNTERS: dict[str, int] = {
    "rag_retrieval_ok": 0,               # RETRIEVE_AND_ANSWER + >=1 chunk returned
    "rag_no_memory_found": 0,            # empty query, router non-retrieve, or retriever 0 chunks
    "rag_retrieval_error": 0,            # exception in router/retrieve path
    "alpha_self_memory_attempted": 0,    # ALPHA_USE_SELF_MEMORY=1 and append helper invoked
    "alpha_self_memory_empty": 0,        # attempted but alpha_block empty/skipped/errored
}


def _rag_counter_incr(name: str) -> None:
    """Increment one retrieval degradation counter. Unknown names are silently ignored."""
    if name in _RAG_COUNTERS:
        _RAG_COUNTERS[name] += 1


def _rag_counters_print_at_exit() -> None:
    """Print retrieval degradation counters on process shutdown.
    Silent when no retrieval occurred (avoids stdout contamination in wave harnesses).
    """
    try:
        total_retrievals = (
            _RAG_COUNTERS["rag_retrieval_ok"]
            + _RAG_COUNTERS["rag_no_memory_found"]
            + _RAG_COUNTERS["rag_retrieval_error"]
        )
        if total_retrievals == 0 and _RAG_COUNTERS["alpha_self_memory_attempted"] == 0:
            return
        log(
            "RAG",
            C_DIM,
            "retrieval_counters_at_exit",
            " ".join(f"{k}={v}" for k, v in _RAG_COUNTERS.items()),
        )
    except Exception:
        pass  # Observability must never break shutdown


